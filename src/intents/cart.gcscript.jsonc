{
    "type": "script",
    "title": "Cart",
    "description": "Simple example on how to compose to bundle several P2P DeFi Kernel intents on a single transaction. Here we have 2 fills and 1 open being executed at once on a single transaction",
    "exportAs": "cartLimitOrder",
    "return":{
        "mode":"last"
    },    
    "args": {
        "items":[
            {
              "offer-policy-id": "ada",
              "offer-asset-name": "ada",
              "ask-policy-id": "d4fece6b39f7cd78a3f036b2ae6508c13524b863922da80f68dd9ab7",
              "ask-asset-name": "5553444d",
              "price-numerator": "2871177",
              "price-denominator": "10000000",
              "utxo-tx-hash": "969bf762ce0c8daf625536cf8ad3e2018c4ea6431d589523538a458fa229b336",
              "utxo-tx-index": "1",
              "utxo-coin-quantity": "8427820",
              "utxo-offer-quantity": "8427820",
              "utxo-ask-quantity": "0",
              "offer-quantity": "3000000",
              "ask-quantity": "861354",
              "owner-stake-keyhash": "f3eb9839fb3be3e66b330bc9d3213d498c3d61a1fe4b33699f04dce5",
              "intent-id": "969bf762-1-1780802629653-7d4f3230"
            },
            {
              "offer-policy-id": "ada",
              "offer-asset-name": "ada",
              "ask-policy-id": "d4fece6b39f7cd78a3f036b2ae6508c13524b863922da80f68dd9ab7",
              "ask-asset-name": "5553444d",
              "price-numerator": "142329",
              "price-denominator": "500000",
              "utxo-tx-hash": "4aab3f65a4b2aff47ad527d7d501382ad335970e9fe3c9cf6cf10f5c626e78e0",
              "utxo-tx-index": "1",
              "utxo-coin-quantity": "7698610",
              "utxo-offer-quantity": "7698610",
              "utxo-ask-quantity": "0",
              "offer-quantity": "3500000",
              "ask-quantity": "996303",
              "owner-stake-keyhash": "f3eb9839fb3be3e66b330bc9d3213d498c3d61a1fe4b33699f04dce5",
              "intent-id": "4aab3f65-1-1780802635772-8a8e8211"
            },
            {
              "offer-policy-id": "ada",
              "offer-asset-name": "ada",
              "ask-policy-id": "d4fece6b39f7cd78a3f036b2ae6508c13524b863922da80f68dd9ab7",
              "ask-asset-name": "5553444d",
              "offer-quantity": "9000000",
              "price-numerator": "1",
              "price-denominator": "3",
              "owner-stake-keyhash": "f3eb9839fb3be3e66b330bc9d3213d498c3d61a1fe4b33699f04dce5",
              "intent-id": "3f20bdbd-1-1780864364089-7b6fde7c"
            },
            // {
            //   "offer-policy-id": "d4fece6b39f7cd78a3f036b2ae6508c13524b863922da80f68dd9ab7",
            //   "offer-asset-name": "5553444d",
            //   "ask-policy-id": "ada",
            //   "ask-asset-name": "ada",
            //   "utxo-tx-hash": "677f6b7108713e232028e1bf34e7dd4d59e8d785aefb457c7e849ebacf4d8dae",
            //   "utxo-tx-index": "1",
            //   "utxo-coin-quantity": "2577380",
            //   "utxo-offer-quantity": "8000000",
            //   "utxo-ask-quantity": "0",
            //   "owner-stake-keyhash": "f3eb9839fb3be3e66b330bc9d3213d498c3d61a1fe4b33699f04dce5",
            //   "intent-id": "677f6b71-1-1780864249967-e01eae35"
            // }
        ]

    },
    "run": {
        //GCScript functions consume/request permissions, so functions like this one should be called once! Is not a good practice to abuse calling functions 
        "myAddress": {
            "type": "getCurrentAddress"
        },
        "intents": {
            "type": "$importAsScript",
            // TODO: make gc-lib build-time handler behave as preprocessor handler importAsScript to pass fallback values inherited by all keys                        
            // "args": {
            //     "offer-address"       : "{get('cache.myAddress')}"
            // },
            "argsByKey":{
                "0":{
                    "offer-policy-id"     : "{get('args.items.0.offer-policy-id')}",
                    "offer-asset-name"    : "{get('args.items.0.offer-asset-name')}",
                    "ask-policy-id"       : "{get('args.items.0.ask-policy-id')}",
                    "ask-asset-name"      : "{get('args.items.0.ask-asset-name')}",
                    "price-numerator"     : "{get('args.items.0.price-numerator')}",
                    "price-denominator"   : "{get('args.items.0.price-denominator')}",

                    "utxo-tx-hash"        : "{get('args.items.0.utxo-tx-hash')}",
                    "utxo-tx-index"       : "{get('args.items.0.utxo-tx-index')}",
                    "utxo-coin-quantity"  : "{get('args.items.0.utxo-coin-quantity')}",
                    "utxo-offer-quantity" : "{get('args.items.0.utxo-offer-quantity')}",
                    "utxo-ask-quantity"   : "{get('args.items.0.utxo-ask-quantity')}",
                    "ask-quantity"        : "{get('args.items.0.ask-quantity')}",
                    "offer-quantity"      : "{get('args.items.0.offer-quantity')}",
                    "offer-address"       : "{get('cache.myAddress')}",
                    "owner-stake-keyhash" : "{get('args.items.0.owner-stake-keyhash')}",
                    "intent-id"           : "{get('args.items.0.intent-id')}"
                },
                "1":{
                    "offer-policy-id"     : "{get('args.items.1.offer-policy-id')}",
                    "offer-asset-name"    : "{get('args.items.1.offer-asset-name')}",
                    "ask-policy-id"       : "{get('args.items.1.ask-policy-id')}",
                    "ask-asset-name"      : "{get('args.items.1.ask-asset-name')}",
                    "price-numerator"     : "{get('args.items.1.price-numerator')}",
                    "price-denominator"   : "{get('args.items.1.price-denominator')}",

                    "utxo-tx-hash"        : "{get('args.items.1.utxo-tx-hash')}",
                    "utxo-tx-index"       : "{get('args.items.1.utxo-tx-index')}",
                    "utxo-coin-quantity"  : "{get('args.items.1.utxo-coin-quantity')}",
                    "utxo-offer-quantity" : "{get('args.items.1.utxo-offer-quantity')}",
                    "utxo-ask-quantity"   : "{get('args.items.1.utxo-ask-quantity')}",
                    "ask-quantity"        : "{get('args.items.1.ask-quantity')}",
                    "offer-quantity"      : "{get('args.items.1.offer-quantity')}",
                    "offer-address"       : "{get('cache.myAddress')}",
                    "owner-stake-keyhash" : "{get('args.items.1.owner-stake-keyhash')}",
                    "intent-id"           : "{get('args.items.1.intent-id')}"
                },
                "2":{
                    "offer-policy-id"     : "{get('args.items.2.offer-policy-id')}",
                    "offer-asset-name"    : "{get('args.items.2.offer-asset-name')}",
                    "ask-policy-id"       : "{get('args.items.2.ask-policy-id')}",
                    "ask-asset-name"      : "{get('args.items.2.ask-asset-name')}",
                    "price-numerator"     : "{get('args.items.2.price-numerator')}",
                    "price-denominator"   : "{get('args.items.2.price-denominator')}",

                    "utxo-tx-hash"        : "{get('args.items.2.utxo-tx-hash')}",
                    "utxo-tx-index"       : "{get('args.items.2.utxo-tx-index')}",
                    "utxo-coin-quantity"  : "{get('args.items.2.utxo-coin-quantity')}",
                    "utxo-offer-quantity" : "{get('args.items.2.utxo-offer-quantity')}",
                    "ask-quantity"        : "{get('args.items.2.ask-quantity')}",
                    "offer-quantity"      : "{get('args.items.2.offer-quantity')}",
                    "offer-address"       : "{get('cache.myAddress')}",
                    "owner-stake-keyhash" : "{get('args.items.2.owner-stake-keyhash')}",
                    "intent-id"           : "{get('args.items.2.intent-id')}"
                },
                // "3":{
                //     "offer-policy-id"     : "{get('args.items.3.offer-policy-id')}",
                //     "offer-asset-name"    : "{get('args.items.3.offer-asset-name')}",
                //     "ask-policy-id"       : "{get('args.items.3.ask-policy-id')}",
                //     "ask-asset-name"      : "{get('args.items.3.ask-asset-name')}",
                //     "price-numerator"     : "{get('args.items.3.price-numerator')}",
                //     "price-denominator"   : "{get('args.items.3.price-denominator')}",

                //     "utxo-tx-hash"        : "{get('args.items.3.utxo-tx-hash')}",
                //     "utxo-tx-index"       : "{get('args.items.3.utxo-tx-index')}",
                //     "utxo-coin-quantity"  : "{get('args.items.3.utxo-coin-quantity')}",
                //     "utxo-offer-quantity" : "{get('args.items.3.utxo-offer-quantity')}",
                //     "utxo-ask-quantity"   : "{get('args.items.3.utxo-ask-quantity')}",
                //     "ask-quantity"        : "{get('args.items.3.ask-quantity')}",
                //     "offer-quantity"      : "{get('args.items.3.offer-quantity')}",
                //     "offer-address"       : "{get('cache.myAddress')}",
                //     "owner-stake-keyhash" : "{get('args.items.3.owner-stake-keyhash')}",
                //     "intent-id"           : "{get('args.items.3.intent-id')}"
                // }
            },                   
            "from": {
                "0": "app://lib/swap.gcscript.jsonc",
                "1": "app://lib/swap.gcscript.jsonc",
                "2": "app://lib/open.gcscript.jsonc",
                // "3":"app://lib/close.gcscript.jsonc",
            }
        },         
        "tx": {
            "type": "macro",
            "run": {
                "mints": [
                    "{get('cache.intents.2.tx.mints.beacons')}",
                    // "{get('cache.intents.3.tx.mints.beacons')}" // failing node validation with issue with "same mint redeemers"
                ],
                "inputs": [
                    "{get('cache.intents.0.tx.inputs.offerWithBeacons')}",
                    "{get('cache.intents.1.tx.inputs.offerWithBeacons')}",

                    //  "{get('cache.intents.3.tx.inputs.offerWithBeacons')}"

                ],
                "outputs": [
                    "{get('cache.intents.0.tx.outputs.filledOffer')}",
                    "{get('cache.intents.1.tx.outputs.filledOffer')}",
                    
                    "{get('cache.intents.0.tx.outputs.remainingOfferWithBeacons')}",                                        
                    "{get('cache.intents.1.tx.outputs.remainingOfferWithBeacons')}",       
                    
                    "{get('cache.intents.2.tx.outputs.offerWithBeacons')}",   
                    // "{get('cache.intents.3.tx.outputs.unfilledOffer')}"                                        

                    
                ],
                "witnesses": {
                    "plutus": {
                        "scripts": [
                            "{get('cache.intents.0.tx.witnesses.plutus.scripts.spendingValidator')}",
                            "{get('cache.intents.1.tx.witnesses.plutus.scripts.spendingValidator')}",

                            "{get('cache.intents.2.tx.witnesses.plutus.scripts.beaconsPolicy')}",

                            // "{get('cache.intents.3.tx.witnesses.plutus.scripts.beaconsPolicy')}",
                            // "{get('cache.intents.3.tx.witnesses.plutus.scripts.spendingValidator')}"

                        ],
                        "consumers": [
                            "{get('cache.intents.0.tx.witnesses.plutus.consumers.offerWithBeaconsSpend')}",
                            "{get('cache.intents.1.tx.witnesses.plutus.consumers.offerWithBeaconsSpend')}",

                            "{get('cache.intents.2.tx.witnesses.plutus.consumers.beaconsMint')}",

                            // "{get('cache.intents.3.tx.witnesses.plutus.consumers.beaconsMint')}",
                            // "{get('cache.intents.3.tx.witnesses.plutus.consumers.offerWithBeaconsSpend')}"
                        ]
                    }
                },
                "options": {
                    "collateralCoinSelection": "LASLAD"
                }
            }
        },
        "build": {
            "type": "buildTx",
            "title": "Limit Order Cart",
            "tx": "{get('cache.tx')}"
        },
        "sign": {
            "type": "signTxs",
            "detailedPermissions": false,
            "txs": [
                "{get('cache.build.txHex')}"
            ]
        },
        "submit": {
            "type": "submitTxs",
            "mode": "noWait",
            "noFail": true,
            "extras": true,
            "txs": "{get('cache.sign')}"
        },
        "knownErrors":{
            "type":"macro",
            "run":{
                // Some other common error messages from Ogmios/Cardano GraphQL MKII API could be included here 
                // To consume even less script bytes these could be stored as hashes and check against hashes, not plain text
                "contention":"The transaction contains unknown UTxO references as inputs. This can happen if the inputs you're trying to spend have already been spent, or if you've simply referred to non-existing UTxO altogether. The field 'data.unknownOutputReferences' indicates all unknown inputs."
            }
        },      
        "finally": {
            "type": "macro",
            "run": {       
                "txs":[
                    {
                        // small strings and boolean checks to send back to dapps:
                        "txHash": "{get('cache.build.txHash')}",
                        "status": "{get('cache.submit.txsExtended.0.status')}",
                        "hasContentionError":"{eq(get('cache.submit.txsExtended.0.error'),get('cache.knownErrors.contention'))}",
                        "hasSubmitError":"{eq(get('cache.submit.txsExtended.0.status'),'error')}",

                        // when we can afford packing big payloads back to dapps:
                        // "error": "{get('cache.submit.txsExtended.0.error')}",
                        // "errorDetail": "{get('cache.submit.txsExtended.0.errorDetail')}"
                    }
                ],                         
                "items":[
                    {
                        "txHash": "{get('cache.build.txHash')}",
                        "index": "{get(  join('.','cache.build.indexMap.output', join('-',get('cache.intents.0.intentTag'),'remainingOfferWithBeacons') )  )}",
                        "pairBeacon": "{get('cache.intents.0.pairBeacon')}",
                        "offerPolicyId": "{get('args.items.0.offer-policy-id')}",
                        "offerAssetName": "{get('args.items.0.offer-asset-name')}",
                        "offerBeacon": "{get('cache.intents.0.offerBeacon')}",
                        "askPolicyId": "{get('args.items.0.ask-policy-id')}",
                        "askAssetName": "{get('args.items.0.ask-asset-name')}",
                        "askBeacon": "{get('cache.intents.0.askBeacon')}"
                    },
                    {
                        "txHash": "{get('cache.build.txHash')}",
                        "index": "{get(  join('.','cache.build.indexMap.output', join('-',get('cache.intents.1.intentTag'),'remainingOfferWithBeacons') )  )}",
                        "pairBeacon": "{get('cache.intents.1.pairBeacon')}",
                        "offerPolicyId": "{get('args.items.1.offer-policy-id')}",
                        "offerAssetName": "{get('args.items.1.offer-asset-name')}",
                        "offerBeacon": "{get('cache.intents.1.offerBeacon')}",
                        "askPolicyId": "{get('args.items.1.ask-policy-id')}",
                        "askAssetName": "{get('args.items.1.ask-asset-name')}",
                        "askBeacon": "{get('cache.intents.1.askBeacon')}"
                    },
                    {
                        "txHash": "{get('cache.build.txHash')}",
                        "index": "{get(  join('.','cache.build.indexMap.output', join('-',get('cache.intents.2.intentTag'),'remainingOfferWithBeacons') )  )}",
                        "pairBeacon": "{get('cache.intents.2.pairBeacon')}",
                        "offerPolicyId": "{get('args.items.2.offer-policy-id')}",
                        "offerAssetName": "{get('args.items.2.offer-asset-name')}",
                        "offerBeacon": "{get('cache.intents.2.offerBeacon')}",
                        "askPolicyId": "{get('args.items.2.ask-policy-id')}",
                        "askAssetName": "{get('args.items.2.ask-asset-name')}",
                        "askBeacon": "{get('cache.intents.2.askBeacon')}"
                    },
                    // {
                    //     "txHash": "{get('cache.build.txHash')}",
                    //     "index": "{get(  join('.','cache.build.indexMap.output', join('-',get('cache.intents.3.intentTag'),'remainingOfferWithBeacons') )  )}",
                    //     "pairBeacon": "{get('cache.intents.3.pairBeacon')}",
                    //     "offerPolicyId": "{get('args.items.3.offer-policy-id')}",
                    //     "offerAssetName": "{get('args.items.3.offer-asset-name')}",
                    //     "offerBeacon": "{get('cache.intents.3.offerBeacon')}",
                    //     "askPolicyId": "{get('args.items.3.ask-policy-id')}",
                    //     "askAssetName": "{get('args.items.3.ask-asset-name')}",
                    //     "askBeacon": "{get('cache.intents.3.askBeacon')}"
                    // }
                ]
                                    
            }
        }         
    }
}
