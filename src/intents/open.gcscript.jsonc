{
    "type": "script",
    "title": "Open Offer",
    "description": "Opening a one-way swap offer on P2P DeFi Kernel...",    
    "exportAs": "openLimitOrder",
    "require": {
        "networkTag": "preprod",
        "not": {
            "walletTypeIn": [
                "burner",
                "gift"
            ]
        }
    },
    "return":{
        "mode":"last"
    },    
    "args": {
        "offer-policy-id": "ada",
        "offer-asset-name": "ada",
        "offer-quantity": "3000000",
        "ask-policy-id": "d4fece6b39f7cd78a3f036b2ae6508c13524b863922da80f68dd9ab7",
        "ask-asset-name": "5553444d",
        "price-numerator": "1",
        "price-denominator": "3",         

        "owner-stake-keyhash": "f3eb9839fb3be3e66b330bc9d3213d498c3d61a1fe4b33699f04dce5",
        "intent-id": "1"
    },
    "run": {
        "networkInfo": {
            "type": "getNetworkInfo"
        },
        "openOfferIntent": {
            "type": "$importAsScript",                        
            "args": {
                "dltTag"              : "{get('cache.networkInfo.dltTag')}",
                "networkTag"          : "{get('cache.networkInfo.networkTag')}",
                "offer-policy-id"     : "{get('args.offer-policy-id')}",
                "offer-asset-name"    : "{get('args.offer-asset-name')}",
                "offer-quantity"      : "{get('args.offer-quantity')}",
                "ask-policy-id"       : "{get('args.ask-policy-id')}",
                "ask-asset-name"      : "{get('args.ask-asset-name')}",
                "price-numerator"     : "{get('args.price-numerator')}",
                "price-denominator"   : "{get('args.price-denominator')}",
                "owner-stake-keyhash" : "{get('args.owner-stake-keyhash')}",
                "intent-id"           : "{get('args.intent-id')}"
            },
            "return":{
                "mode":"macro",
                "exec":"{get('cache.openOfferIntent.open')}"
            },                    
            "from": {
                "open": "app://lib/open.gcscript.jsonc"
            }
        },        
        // "openOfferIntent": {
        //     "type": "script",
        //     "args": "{get('args')}",
        //     "return":{
        //         "mode":"macro",
        //         "exec":"{get('cache.openOfferIntent.import.open')}"
        //     },
        //     "run": {  
        //         "import": {
        //             "type": "$importAsScript",                        
        //             "args": "{get('args')}",
        //             "from": {
        //                 "open": "app://lib/open.gcscript.jsonc"
        //             }
        //         }                
        //     }
        // }, 
        "tx": {
            "type": "macro",
            "run": {
                "mints": [
                    "{get('cache.openOfferIntent.tx.mints.beacons')}"
                ],
                "outputs": [
                    "{get('cache.openOfferIntent.tx.outputs.offerWithBeacons')}"                                        
                ],
                "witnesses": {
                    "plutus": {
                        "scripts": [
                            "{get('cache.openOfferIntent.tx.witnesses.plutus.scripts.beaconsPolicy')}"
                        ],
                        "consumers": [
                            "{get('cache.openOfferIntent.tx.witnesses.plutus.consumers.beaconsMint')}"
                        ]
                    }
                },
                "options": {
                    "collateralCoinSelection": "LASLAD"
                }
            }
        },
        "build": {
            "type": "buildTx",
            "title": "Open Limit Order",
            "tx": "{get('cache.tx')}"
        },
        "sign": {
            "type": "signTxs",
            "detailedPermissions": false,
            "txs": [
                "{get('cache.build.txHex')}"
            ]
        },
        "submit": {
            "type": "submitTxs",
            "mode": "noWait",
            "noFail": true,
            "extras": true,
            "txs": "{get('cache.sign')}"
        },
        "knownErrors": {
            "type": "macro",
            "run": {
                "contention": "The transaction contains unknown UTxO references as inputs. This can happen if the inputs you're trying to spend have already been spent, or if you've simply referred to non-existing UTxO altogether. The field 'data.unknownOutputReferences' indicates all unknown inputs."
            }
        },
        "finally": {
            "type": "macro",
            "run": {
                "status": "{get('cache.submit.txsExtended.0.status')}",
                "hasSubmitError": "{eq(get('cache.submit.txsExtended.0.status'),'error')}",
                "hasContentionError": "{eq(get('cache.submit.txsExtended.0.error'),get('cache.knownErrors.contention'))}",
                "txHash": "{get('cache.build.txHash')}",
                "index": "{get('cache.build.indexMap.output.swap-output')}",
                "pairBeacon": "{get('cache.openOfferIntent.pairBeacon')}",
                "offerPolicyId": "{get('args.offer-policy-id')}",
                "offerAssetName": "{get('args.offer-asset-name')}",
                "offerBeacon": "{get('cache.openOfferIntent.offerBeacon')}",
                "askPolicyId": "{get('args.ask-policy-id')}",
                "askAssetName": "{get('args.ask-asset-name')}",
                "askBeacon": "{get('cache.openOfferIntent.askBeacon')}"                    
            }
        }         
    }
}
