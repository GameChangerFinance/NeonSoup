//Example args
// "args": {
//     "offer-policy-id": "d4fece6b39f7cd78a3f036b2ae6508c13524b863922da80f68dd9ab7",
//     "offer-asset-name": "5553444d",
//     "ask-policy-id": "ada",
//     "ask-asset-name": "ada",            
//     "price-numerator": "3",
//     "price-denominator": "1",       

//     "utxo-tx-hash": "59e968d21a2f49368f38073301ab6a40f25d36a408a365939cba5c2869b2eba0",
//     "utxo-tx-index": "0",
//     "utxo-coin-quantity": "10000000",
//     "utxo-offer-quantity": "10000000",        
//     "utxo-ask-quantity": "0",
//     "ask-quantity": "1500000",        
//     "offer-quantity": "500000",
//     "offer-address": "addr_test1qpf7s7teq4d5g5sfhztshnxjvfnlxtz335mwnq2ruvvd8k9a9ww7ur94zw24dnf6wwrvp5v4u937m0zpjwqjqt2898ks4wugl5",
//     "owner-stake-keyhash": "f3eb9839fb3be3e66b330bc9d3213d498c3d61a1fe4b33699f04dce5",
//     "intent-id": "1"
// },

{
    "type": "script",
    "title": "Preparing Swap...",
    "description": "Preparing a composable intent to fill a one-way swap offer on P2P DeFi Kernel...",    
    "return":{
        "mode":"last"
    },    
    "args": "{get('args')}",    
    "isolateCache": true,
    "run": {
        "intentTag":{
            "type":"macro",
            "run":"{join('-','P2PDeFiKernel','OWS','swap',get('args.intent-id'))}"
        },        
        "dependencies": {
            "type": "$importAsScript",                        
            "args": "{get('args')}",
            "return":{
                "mode":"macro",
                "exec":"{get('cache.dependencies.common')}"
            },                  
            "from": {
                "common": "app://./common.gcscript.jsonc"
            }
        },           
        // "dependencies": {
        //     "type": "script",
        //     "args": "{get('args')}",
        //     "return":{
        //         "mode":"macro",
        //         "exec":"{get('cache.dependencies.import.common')}"
        //     },
        //     "run": {
        //         "import": {
        //             "type": "$importAsScript",                        
        //             "args": "{get('args')}",
        //             "from": {
        //                 "common": "app://./common.gcscript.jsonc"
        //             }
        //         }                    
        //     }
        // },    
        "coinDelta":{
            "type": "macro",
            "run":{
                "askDeposit": {
                    "coin": "{get('args.ask-quantity')}",
                    "token": "0"
                },
                "offerTaken": {
                    "coin": "{get('args.offer-quantity')}",
                    "token": "0"
                }
            }
        }, 
        "remainingADA": {
            "type": "macro",
            "run": "{subBigNum(addBigNum(get('args.utxo-coin-quantity'), get(join('.','cache','coinDelta','askDeposit',get('cache.dependencies.assetKindForTx.ask')))), get(join('.','cache','coinDelta','offerTaken',get('cache.dependencies.assetKindForTx.offer'))))}"
        },                
        "remainingOffer": {
            "type": "macro",
            "run": "{subBigNum(get('args.utxo-offer-quantity'), get('args.offer-quantity'))}"
        },
        "continuingAsk": {
            "type": "macro",
            "run": "{addBigNum(get('args.utxo-ask-quantity'), get('args.ask-quantity'))}"
        },
        "tokenOutputQuantity":{
            "type": "macro",
            "run":{
                "remainingOffer":{
                    "coin":"0",
                    "token":"{get('cache.remainingOffer')}"
                },
                "askDeposit":{
                    "coin":"0",
                    "token":"{get('cache.continuingAsk')}"
                }
            }
        },        
        "swapDatum": {
            "type": "plutusData",
            "data": {
                "fromJSON": {
                    "schema": 1,
                    "obj": {
                        "constructor": 0,
                        "fields": [
                            {"bytes": "{get('cache.dependencies.beaconsPolicy.scriptHashHex')}"},
                            {"bytes": "{get('cache.dependencies.pairBeacon')}"},
                            {"bytes": "{get('cache.dependencies.normalized.forDatum.offer-policy-id')}"},
                            {"bytes": "{get('cache.dependencies.normalized.forDatum.offer-asset-name')}"},
                            {"bytes": "{get('cache.dependencies.offerBeacon')}"},
                            {"bytes": "{get('cache.dependencies.normalized.forDatum.ask-policy-id')}"},
                            {"bytes": "{get('cache.dependencies.normalized.forDatum.ask-asset-name')}"},
                            {"bytes": "{get('cache.dependencies.askBeacon')}"},
                            {"constructor": 0, "fields": [
                                {"int": "{jsonToObj(get('args.price-numerator'))}"},
                                {"int": "{jsonToObj(get('args.price-denominator'))}"}
                            ]},
                            {"constructor": 0, "fields": [
                                {"constructor": 0, "fields": [
                                    {"constructor": 0, "fields": [
                                        {"bytes": "{get('args.utxo-tx-hash')}"}
                                    ]},
                                    {"int": "{jsonToObj(get('args.utxo-tx-index'))}"}
                                ]}
                            ]},
                            {"constructor": 1, "fields": []}
                        ]
                    }
                }
            }
        },          
        "swapRedeemer": {
            "type": "plutusData",
            "data": {
                "fromJSON": {
                    "schema": 1,
                    "obj": {
                        // Former code used constructor 1, which is SpendWithStake
                        // in the one-way swap validator and requires owner approval.
                        // Fill is permissionless and must use Swap, constructor 2.
                        // "constructor": 1,
                        "constructor": 2,
                        "fields": []
                    }
                }
            }
        },
        "tx": {
            "type": "macro",
            "run": {
                "inputs": {
                    "offerWithBeacons":{
                        "txHash": "{get('args.utxo-tx-hash')}",
                        "index": "{jsonToObj(get('args.utxo-tx-index'))}",
                        "idPattern": "{join('-',get('cache.intentTag'),'offerWithBeacons')}"
                    }
                },
                "outputs": {
                    "filledOffer":{
                        "idPattern": "{join('-',get('cache.intentTag'),'filledOffer')}",
                        "address": "{get('args.offer-address')}",
                        "assets": [
                            {
                                "policyId": "{get('cache.dependencies.normalized.forTx.offer-policy-id')}",
                                "assetNameHex": "{get('cache.dependencies.normalized.forTx.offer-asset-name')}",
                                "quantity": "{get('args.offer-quantity')}"
                            }
                        ]
                    },
                    "remainingOfferWithBeacons":{
                        "idPattern": "{join('-',get('cache.intentTag'),'remainingOfferWithBeacons')}",
                        "address": "{get('cache.dependencies.dappAddress')}",
                        "datum": {
                            "datumHex": "{get('cache.swapDatum.dataHex')}"
                        },
                        "assets": [
                            {
                                "policyId": "ada",
                                "assetNameHex": "ada",
                                "quantity": "{get('cache.remainingADA')}"
                            },
                            {
                                "policyId": "{get('cache.dependencies.normalized.forTx.offer-policy-id')}",
                                "assetNameHex": "{get('cache.dependencies.normalized.forTx.offer-asset-name')}",
                                "quantity": "{get(join('.','cache','tokenOutputQuantity','remainingOffer',get('cache.dependencies.assetKindForTx.offer')))}"
                            },
                            {
                                // Deposit the ask asset into the continuing order.
                                // For ADA asks this resolves to zero because ADA is
                                // handled by remainingADA above.
                                "policyId": "{get('cache.dependencies.normalized.forTx.ask-policy-id')}",
                                "assetNameHex": "{get('cache.dependencies.normalized.forTx.ask-asset-name')}",
                                "quantity": "{get(join('.','cache','tokenOutputQuantity','askDeposit',get('cache.dependencies.assetKindForTx.ask')))}"
                            },
                            {
                                "policyId": "{get('cache.dependencies.beaconsPolicy.scriptHashHex')}",
                                "assetNameHex": "{get('cache.dependencies.pairBeacon')}",
                                "quantity": "1"
                            },
                            {
                                "policyId": "{get('cache.dependencies.beaconsPolicy.scriptHashHex')}",
                                "assetNameHex": "{get('cache.dependencies.offerBeacon')}",
                                "quantity": "1"
                            },
                            {
                                "policyId": "{get('cache.dependencies.beaconsPolicy.scriptHashHex')}",
                                "assetNameHex": "{get('cache.dependencies.askBeacon')}",
                                "quantity": "1"
                            }
                        ]                        
                    }
                },
                "witnesses": {
                    "plutus": {
                        "scripts": {
                            "spendingValidator":{
                                "scriptHashHex": "{get('cache.dependencies.spendingValidator.scriptHashHex')}",
                                "lang": "{get('cache.dependencies.spendingValidator.lang')}",
                                "scriptSize": "{get('cache.dependencies.spendingValidator.scriptSize')}",
                                "input": "{get('cache.dependencies.spendingValidator.input')}"                                
                            }
                        },
                        "consumers": {
                            "offerWithBeaconsSpend":{
                                "scriptHashHex": "{get('cache.dependencies.spendingValidator.scriptHashHex')}",
                                "redeemer": {
                                    "dataHex": "{get('cache.swapRedeemer.dataHex')}",
                                    "type": "spend",
                                    "itemIdPattern": "{join('-',get('cache.intentTag'),'offerWithBeacons')}"
                                }
                            }
                        }
                    }
                },
                "options": {
                    "collateralCoinSelection": "LASLAD"
                }
            }
        },
        "finally": {
            "type": "macro",
            "run": {
                "intentTag":"{get('cache.intentTag')}",
                "tx": "{get('cache.tx')}",
                "pairBeacon": "{get('cache.dependencies.pairBeacon')}",
                "offerPolicyId": "{get('args.offer-policy-id')}",
                "offerAssetName": "{get('args.offer-asset-name')}",
                "offerBeacon": "{get('cache.dependencies.offerBeacon')}",
                "askPolicyId": "{get('args.ask-policy-id')}",
                "askAssetName": "{get('args.ask-asset-name')}",
                "askBeacon": "{get('cache.dependencies.askBeacon')}"                    
            }
        }         
    }
}
