{
    "type": "script",
    "title": "Close Offer",
    "description": "Closing a one-way swap offer on P2P DeFi Kernel and withdraw remaining asset...",    
    "exportAs": "openLimitOrder",
    "return":{
        "mode":"last"
    },    
    "args": {
        "offer-policy-id": "ada",
        "offer-asset-name": "ada",
        "ask-policy-id": "d4fece6b39f7cd78a3f036b2ae6508c13524b863922da80f68dd9ab7",
        "ask-asset-name": "5553444d",


        "utxo-tx-hash": "59e968d21a2f49368f38073301ab6a40f25d36a408a365939cba5c2869b2eba0",
        "utxo-tx-index": "0",
        "utxo-coin-quantity": "10000000",
        "utxo-offer-quantity": "10000000",
        "offer-address": "addr_test1qpf7s7teq4d5g5sfhztshnxjvfnlxtz335mwnq2ruvvd8k9a9ww7ur94zw24dnf6wwrvp5v4u937m0zpjwqjqt2898ks4wugl5",
        "owner-stake-keyhash": "f3eb9839fb3be3e66b330bc9d3213d498c3d61a1fe4b33699f04dce5",        
        "intent-id": "1"
    },
    "run": {
        "myAddress": {
            "type": "getCurrentAddress"
        },
        "closeOfferIntent": {
            "type": "$importAsScript",                        
            "args": {
                "offer-policy-id"     : "{get('args.offer-policy-id')}",
                "offer-asset-name"    : "{get('args.offer-asset-name')}",
                "ask-policy-id"       : "{get('args.ask-policy-id')}",
                "ask-asset-name"      : "{get('args.ask-asset-name')}",

                "utxo-tx-hash"        : "{get('args.utxo-tx-hash')}",
                "utxo-tx-index"       : "{get('args.utxo-tx-index')}",
                "utxo-coin-quantity"  : "{get('args.utxo-coin-quantity')}",
                "utxo-offer-quantity" : "{get('args.utxo-offer-quantity')}",
                "offer-address"       : "{get('cache.myAddress')}",
                "owner-stake-keyhash" : "{get('args.owner-stake-keyhash')}",
                "intent-id"           : "{get('args.intent-id')}"
            },
            "return":{
                "mode":"macro",
                "exec":"{get('cache.closeOfferIntent.close')}"
            },                    
            "from": {
                "close": "app://lib/close.gcscript.jsonc"
            }
        },           
        // "closeOfferIntent": {
        //     "type": "script",
        //     "args":{
        //         "offer-policy-id"     : "{get('args.offer-policy-id')}",
        //         "offer-asset-name"    : "{get('args.offer-asset-name')}",
        //         "ask-policy-id"       : "{get('args.ask-policy-id')}",
        //         "ask-asset-name"      : "{get('args.ask-asset-name')}",

        //         "utxo-tx-hash"        : "{get('args.utxo-tx-hash')}",
        //         "utxo-tx-index"       : "{get('args.utxo-tx-index')}",
        //         "utxo-coin-quantity"  : "{get('args.utxo-coin-quantity')}",
        //         "utxo-offer-quantity" : "{get('args.utxo-offer-quantity')}",
        //         "offer-address"       : "{get('cache.myAddress')}",
        //         "owner-stake-keyhash" : "{get('args.owner-stake-keyhash')}",
        //         "intent-id"           : "{get('args.intent-id')}"

        //     },
        //     "return":{
        //         "mode":"macro",
        //         "exec":"{get('cache.closeOfferIntent.import.close')}"
        //     },
        //     "run": { 
        //         "import": {
        //             "type": "$importAsScript",                        
        //             "args": "{get('args')}",
        //             "from": {
        //                 "close": "app://lib/close.gcscript.jsonc"
        //             }
        //         }                
        //     }
        // }, 
        "tx": {
            "type": "macro",
            "run": {
                "inputs": [
                    "{get('cache.closeOfferIntent.tx.inputs.offerWithBeacons')}"
                ],                
                "mints": [
                    "{get('cache.closeOfferIntent.tx.mints.beacons')}"
                ],
                "outputs": [
                    "{get('cache.closeOfferIntent.tx.outputs.unfilledOffer')}"                                        
                ],
                "witnesses": {
                    "plutus": {
                        "scripts": [
                            "{get('cache.closeOfferIntent.tx.witnesses.plutus.scripts.beaconsPolicy')}",
                            "{get('cache.closeOfferIntent.tx.witnesses.plutus.scripts.spendingValidator')}"
                        ],
                        "consumers": [
                            "{get('cache.closeOfferIntent.tx.witnesses.plutus.consumers.beaconsMint')}",
                            "{get('cache.closeOfferIntent.tx.witnesses.plutus.consumers.offerWithBeaconsSpend')}"
                        ]
                    }
                },
                "options": {
                    "collateralCoinSelection": "LASLAD"
                }
            }
        },
        "build": {
            "type": "buildTx",
            "title": "Close Limit Order",
            "tx": "{get('cache.tx')}"
        },
        "sign": {
            "type": "signTxs",
            "detailedPermissions": false,
            "txs": [
                "{get('cache.build.txHex')}"
            ]
        },
        "submit": {
            "type": "submitTxs",
            "mode": "noWait",
            "txs": "{get('cache.sign')}"
        },
        "finally": {
            "type": "macro",
            "run": {                                
                "txHash": "{get('cache.build.txHash')}",
                "index": "{get(  join('.','cache.build.indexMap.output', join('-',get('cache.closeOfferIntent.intentTag'),'unfilledOffer') )  )}",
                "pairBeacon": "{get('cache.closeOfferIntent.pairBeacon')}",
                "offerPolicyId": "{get('args.offer-policy-id')}",
                "offerAssetName": "{get('args.offer-asset-name')}",
                "offerBeacon": "{get('cache.closeOfferIntent.offerBeacon')}",
                "askPolicyId": "{get('args.ask-policy-id')}",
                "askAssetName": "{get('args.ask-asset-name')}",
                "askBeacon": "{get('cache.closeOfferIntent.askBeacon')}"                    
            }
        }         
    }
}
