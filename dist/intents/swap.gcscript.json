{
  "type": "script",
  "title": "Swap",
  "description": "Filling a one-way swap offer on P2P DeFi Kernel...",
  "exportAs": "swapLimitOrder",
  "return": {
    "mode": "last"
  },
  "args": {
    "offer-policy-id": "d4fece6b39f7cd78a3f036b2ae6508c13524b863922da80f68dd9ab7",
    "offer-asset-name": "5553444d",
    "ask-policy-id": "ada",
    "ask-asset-name": "ada",
    "price-numerator": "3",
    "price-denominator": "1",
    "utxo-tx-hash": "59e968d21a2f49368f38073301ab6a40f25d36a408a365939cba5c2869b2eba0",
    "utxo-tx-index": "0",
    "utxo-coin-quantity": "10000000",
    "utxo-offer-quantity": "10000000",
    "ask-quantity": "1500000",
    "offer-quantity": "500000",
    "owner-stake-keyhash": "f3eb9839fb3be3e66b330bc9d3213d498c3d61a1fe4b33699f04dce5",
    "intent-id": "1"
  },
  "run": {
    "myAddress": {
      "type": "getCurrentAddress"
    },
    "swapOfferIntent": {
      "return": {
        "mode": "macro",
        "exec": "{get('cache.swapOfferIntent.swap')}"
      },
      "type": "script",
      "run": {
        "swap": {
          "type": "script",
          "title": "Preparing Swap...",
          "description": "Preparing a composable intent to fill a one-way swap offer on P2P DeFi Kernel...",
          "return": {
            "mode": "last"
          },
          "args": "{get('args')}",
          "isolateCache": true,
          "run": {
            "intentTag": {
              "type": "macro",
              "run": "{join('-','P2PDeFiKernel','OWS','swap',get('args.intent-id'))}"
            },
            "dependencies": {
              "return": {
                "mode": "macro",
                "exec": "{get('cache.dependencies.common')}"
              },
              "type": "script",
              "run": {
                "common": {
                  "type": "script",
                  "title": "Normalizing data...",
                  "description": "Formatting and normalizing common P2P DeFi Kernel OWS parameters...",
                  "args": "{get('args')}",
                  "isolateCache": true,
                  "run": {
                    "beaconsPolicy": {
                      "type": "data",
                      "value": {
                        "scriptHashHex": "c4d7d117d9ebcde6db28db40837ff2b1401e9eaaa6eecea9e070e209",
                        "scriptSize": 4595,
                        "lang": "plutus_v2",
                        "input": {
                          "index": 0,
                          "txHash": "7b613fc2481a93b950f3bf48f8fbc5c49d6decce126a3572fab428feb73ed5b0"
                        }
                      }
                    },
                    "spendingValidator": {
                      "type": "data",
                      "value": {
                        "scriptHashHex": "1d6cff26bcab91d2061aad0bd259cbb7d76d25ced2eeaed5926a42ad",
                        "scriptSize": 4505,
                        "lang": "plutus_v2",
                        "input": {
                          "txHash": "7b613fc2481a93b950f3bf48f8fbc5c49d6decce126a3572fab428feb73ed5b0",
                          "index": 1
                        }
                      }
                    },
                    "transform": {
                      "type": "macro",
                      "run": {
                        "policyIdToPairBeaconHashingPolicyId": {
                          "{get('args.offer-policy-id')}": "{get('args.offer-policy-id')}",
                          "{get('args.ask-policy-id')}": "{get('args.ask-policy-id')}",
                          "ada": "00"
                        },
                        "assetNameHexToPairBeaconHashingAssetNameHex": {
                          "{get('args.offer-asset-name')}": "{get('args.offer-asset-name')}",
                          "{get('args.ask-asset-name')}": "{get('args.ask-asset-name')}",
                          "ada": "{return('')}"
                        },
                        "policyIdToBeaconHashPolicyId": {
                          "{get('args.offer-policy-id')}": "{get('args.offer-policy-id')}",
                          "{get('args.ask-policy-id')}": "{get('args.ask-policy-id')}",
                          "ada": "{return('')}"
                        },
                        "assetNameHexToBeaconHashAssetNameHex": {
                          "{get('args.offer-asset-name')}": "{get('args.offer-asset-name')}",
                          "{get('args.ask-asset-name')}": "{get('args.ask-asset-name')}",
                          "ada": "{return('')}"
                        },
                        "policyIdToDatumPolicyId": {
                          "{get('args.offer-policy-id')}": "{get('args.offer-policy-id')}",
                          "{get('args.ask-policy-id')}": "{get('args.ask-policy-id')}",
                          "ada": "{return('')}"
                        },
                        "assetNameHexToDatumAssetNameHex": {
                          "{get('args.offer-asset-name')}": "{get('args.offer-asset-name')}",
                          "{get('args.ask-asset-name')}": "{get('args.ask-asset-name')}",
                          "ada": "{return('')}"
                        }
                      }
                    },
                    "normalized": {
                      "type": "macro",
                      "run": {
                        "forDatum": {
                          "offer-policy-id": "{get(join('.','cache','transform','policyIdToDatumPolicyId'                   ,get('args.offer-policy-id')))}",
                          "offer-asset-name": "{get(join('.','cache','transform','assetNameHexToDatumAssetNameHex'           ,get('args.offer-asset-name')))}",
                          "ask-policy-id": "{get(join('.','cache','transform','policyIdToDatumPolicyId'                   ,get('args.ask-policy-id')))}",
                          "ask-asset-name": "{get(join('.','cache','transform','assetNameHexToDatumAssetNameHex'           ,get('args.ask-asset-name')))}"
                        },
                        "forOfferBeaconHashing": {
                          "offer-policy-id": "{get(join('.','cache','transform','policyIdToBeaconHashPolicyId'              ,get('args.offer-policy-id')))}",
                          "offer-asset-name": "{get(join('.','cache','transform','assetNameHexToBeaconHashAssetNameHex'      ,get('args.offer-asset-name')))}",
                          "prefix": "01"
                        },
                        "forAskBeaconHashing": {
                          "ask-policy-id": "{get(join('.','cache','transform','policyIdToBeaconHashPolicyId'              ,get('args.ask-policy-id')))}",
                          "ask-asset-name": "{get(join('.','cache','transform','assetNameHexToBeaconHashAssetNameHex'      ,get('args.ask-asset-name')))}",
                          "prefix": "02"
                        },
                        "forPairBeaconHashing": {
                          "offer-policy-id": "{get(join('.','cache','transform','policyIdToPairBeaconHashingPolicyId'        ,get('args.offer-policy-id')))}",
                          "offer-asset-name": "{get(join('.','cache','transform','assetNameHexToPairBeaconHashingAssetNameHex',get('args.offer-asset-name')))}",
                          "ask-policy-id": "{get(join('.','cache','transform','policyIdToPairBeaconHashingPolicyId'        ,get('args.ask-policy-id')))}",
                          "ask-asset-name": "{get(join('.','cache','transform','assetNameHexToPairBeaconHashingAssetNameHex',get('args.ask-asset-name')))}"
                        },
                        "forTx": {
                          "offer-policy-id": "{get('args.offer-policy-id')}",
                          "offer-asset-name": "{get('args.offer-asset-name')}",
                          "ask-policy-id": "{get('args.ask-policy-id')}",
                          "ask-asset-name": "{get('args.ask-asset-name')}"
                        }
                      }
                    },
                    "pairBeacon": {
                      "type": "macro",
                      "run": "{sha256(flatten(hexToByteArray(get('cache.normalized.forPairBeaconHashing.offer-policy-id')), hexToByteArray(get('cache.normalized.forPairBeaconHashing.offer-asset-name')),  hexToByteArray(get('cache.normalized.forPairBeaconHashing.ask-policy-id')), hexToByteArray(get('cache.normalized.forPairBeaconHashing.ask-asset-name'))))}"
                    },
                    "offerBeacon": {
                      "type": "macro",
                      "run": "{sha256(flatten(hexToByteArray(get('cache.normalized.forOfferBeaconHashing.prefix')), hexToByteArray(get('cache.normalized.forOfferBeaconHashing.offer-policy-id')), hexToByteArray(get('cache.normalized.forOfferBeaconHashing.offer-asset-name'))))}"
                    },
                    "askBeacon": {
                      "type": "macro",
                      "run": "{sha256(flatten(hexToByteArray(get('cache.normalized.forAskBeaconHashing.prefix')), hexToByteArray(get('cache.normalized.forAskBeaconHashing.ask-policy-id')), hexToByteArray(get('cache.normalized.forAskBeaconHashing.ask-asset-name'))))}"
                    },
                    "dappAddress": {
                      "type": "buildAddress",
                      "name": "DAppAddress",
                      "addr": {
                        "spendScriptHashHex": "{get('cache.spendingValidator.scriptHashHex')}",
                        "stakePubKeyHashHex": "{get('args.owner-stake-keyhash')}"
                      }
                    },
                    "swapRedeemer": {
                      "type": "plutusData",
                      "data": {
                        "fromJSON": {
                          "schema": 1,
                          "obj": {
                            "constructor": 2,
                            "fields": []
                          }
                        }
                      }
                    }
                  }
                }
              },
              "args": "{get('args')}"
            },
            "quantity": {
              "type": "macro",
              "run": {
                "ask": {
                  "ada-ada": "0",
                  "{join('-', get('args.ask-policy-id'), get('args.ask-asset-name'))}": "{get('args.ask-quantity')}"
                },
                "offer": {
                  "ada-ada": "0",
                  "{join('-', get('args.offer-policy-id'), get('args.offer-asset-name'))}": "{get('args.offer-quantity')}"
                },
                "utxo": {
                  "ada-ada": "{get('args.utxo-coin-quantity')}",
                  "{join('-', get('args.offer-policy-id'), get('args.offer-asset-name'))}": "{get('args.utxo-offer-quantity')}"
                }
              }
            },
            "currentADA": {
              "type": "macro",
              "run": "{get('cache.quantity.utxo.ada-ada')}"
            },
            "currentOffer": {
              "type": "macro",
              "run": "{get(join('.','cache','quantity','utxo',  join('-',get('cache.dependencies.normalized.forTx.offer-policy-id'),get('cache.dependencies.normalized.forTx.offer-asset-name'))  ))}"
            },
            "remainingADA": {
              "type": "macro",
              "run": "{subBigNum(addBigNum(get('cache.currentADA'), get('cache.quantity.ask.ada-ada')), get('cache.quantity.offer.ada-ada'))}"
            },
            "remainingOffer": {
              "type": "macro",
              "run": "{subBigNum(get('cache.currentOffer') , get('args.offer-quantity') )}"
            },
            "outputQuantity": {
              "type": "macro",
              "run": {
                "remainingOffer": {
                  "{join('-', get('args.offer-policy-id'), get('args.offer-asset-name'))}": "{get('cache.remainingOffer')}",
                  "ada-ada": "0"
                },
                "askDeposit": {
                  "{join('-', get('args.ask-policy-id'), get('args.ask-asset-name'))}": "{get('args.ask-quantity')}",
                  "ada-ada": "0"
                }
              }
            },
            "swapDatum": {
              "type": "plutusData",
              "data": {
                "fromJSON": {
                  "schema": 1,
                  "obj": {
                    "constructor": 0,
                    "fields": [
                      {
                        "bytes": "{get('cache.dependencies.beaconsPolicy.scriptHashHex')}"
                      },
                      {
                        "bytes": "{get('cache.dependencies.pairBeacon')}"
                      },
                      {
                        "bytes": "{get('cache.dependencies.normalized.forDatum.offer-policy-id')}"
                      },
                      {
                        "bytes": "{get('cache.dependencies.normalized.forDatum.offer-asset-name')}"
                      },
                      {
                        "bytes": "{get('cache.dependencies.offerBeacon')}"
                      },
                      {
                        "bytes": "{get('cache.dependencies.normalized.forDatum.ask-policy-id')}"
                      },
                      {
                        "bytes": "{get('cache.dependencies.normalized.forDatum.ask-asset-name')}"
                      },
                      {
                        "bytes": "{get('cache.dependencies.askBeacon')}"
                      },
                      {
                        "constructor": 0,
                        "fields": [
                          {
                            "int": "{jsonToObj(get('args.price-numerator'))}"
                          },
                          {
                            "int": "{jsonToObj(get('args.price-denominator'))}"
                          }
                        ]
                      },
                      {
                        "constructor": 0,
                        "fields": [
                          {
                            "constructor": 0,
                            "fields": [
                              {
                                "constructor": 0,
                                "fields": [
                                  {
                                    "bytes": "{get('args.utxo-tx-hash')}"
                                  }
                                ]
                              },
                              {
                                "int": "{jsonToObj(get('args.utxo-tx-index'))}"
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "constructor": 1,
                        "fields": []
                      }
                    ]
                  }
                }
              }
            },
            "swapRedeemer": {
              "type": "plutusData",
              "data": {
                "fromJSON": {
                  "schema": 1,
                  "obj": {
                    "constructor": 2,
                    "fields": []
                  }
                }
              }
            },
            "tx": {
              "type": "macro",
              "run": {
                "inputs": {
                  "offerWithBeacons": {
                    "txHash": "{get('args.utxo-tx-hash')}",
                    "index": "{jsonToObj(get('args.utxo-tx-index'))}",
                    "idPattern": "{join('-',get('cache.intentTag'),'offerWithBeacons')}"
                  }
                },
                "outputs": {
                  "filledOffer": {
                    "idPattern": "{join('-',get('cache.intentTag'),'filledOffer')}",
                    "address": "{get('args.offer-address')}",
                    "assets": [
                      {
                        "policyId": "{get('cache.dependencies.normalized.forTx.offer-policy-id')}",
                        "assetNameHex": "{get('cache.dependencies.normalized.forTx.offer-asset-name')}",
                        "quantity": "{get('args.offer-quantity')}"
                      }
                    ]
                  },
                  "remainingOfferWithBeacons": {
                    "idPattern": "{join('-',get('cache.intentTag'),'remainingOfferWithBeacons')}",
                    "address": "{get('cache.dependencies.dappAddress')}",
                    "datum": {
                      "datumHex": "{get('cache.swapDatum.dataHex')}"
                    },
                    "assets": [
                      {
                        "policyId": "ada",
                        "assetNameHex": "ada",
                        "quantity": "{get('cache.remainingADA')}"
                      },
                      {
                        "policyId": "{get('cache.dependencies.normalized.forTx.offer-policy-id')}",
                        "assetNameHex": "{get('cache.dependencies.normalized.forTx.offer-asset-name')}",
                        "quantity": "{get(join('.','cache','outputQuantity','remainingOffer', join('-',get('cache.dependencies.normalized.forTx.offer-policy-id'),get('cache.dependencies.normalized.forTx.offer-asset-name')) ))}"
                      },
                      {
                        "policyId": "{get('cache.dependencies.normalized.forTx.ask-policy-id')}",
                        "assetNameHex": "{get('cache.dependencies.normalized.forTx.ask-asset-name')}",
                        "quantity": "{get(join('.','cache','outputQuantity','askDeposit', join('-',get('cache.dependencies.normalized.forTx.ask-policy-id'),get('cache.dependencies.normalized.forTx.ask-asset-name')) ))}"
                      },
                      {
                        "policyId": "{get('cache.dependencies.beaconsPolicy.scriptHashHex')}",
                        "assetNameHex": "{get('cache.dependencies.pairBeacon')}",
                        "quantity": "1"
                      },
                      {
                        "policyId": "{get('cache.dependencies.beaconsPolicy.scriptHashHex')}",
                        "assetNameHex": "{get('cache.dependencies.offerBeacon')}",
                        "quantity": "1"
                      },
                      {
                        "policyId": "{get('cache.dependencies.beaconsPolicy.scriptHashHex')}",
                        "assetNameHex": "{get('cache.dependencies.askBeacon')}",
                        "quantity": "1"
                      }
                    ]
                  }
                },
                "witnesses": {
                  "plutus": {
                    "scripts": {
                      "spendingValidator": {
                        "scriptHashHex": "{get('cache.dependencies.spendingValidator.scriptHashHex')}",
                        "lang": "{get('cache.dependencies.spendingValidator.lang')}",
                        "scriptSize": "{get('cache.dependencies.spendingValidator.scriptSize')}",
                        "input": "{get('cache.dependencies.spendingValidator.input')}"
                      }
                    },
                    "consumers": {
                      "offerWithBeaconsSpend": {
                        "scriptHashHex": "{get('cache.dependencies.spendingValidator.scriptHashHex')}",
                        "redeemer": {
                          "dataHex": "{get('cache.swapRedeemer.dataHex')}",
                          "type": "spend",
                          "itemIdPattern": "{join('-',get('cache.intentTag'),'offerWithBeacons')}"
                        }
                      }
                    }
                  }
                },
                "options": {
                  "collateralCoinSelection": "LASLAD"
                }
              }
            },
            "finally": {
              "type": "macro",
              "run": {
                "intentTag": "{get('cache.intentTag')}",
                "tx": "{get('cache.tx')}",
                "pairBeacon": "{get('cache.dependencies.pairBeacon')}",
                "offerPolicyId": "{get('args.offer-policy-id')}",
                "offerAssetName": "{get('args.offer-asset-name')}",
                "offerBeacon": "{get('cache.dependencies.offerBeacon')}",
                "askPolicyId": "{get('args.ask-policy-id')}",
                "askAssetName": "{get('args.ask-asset-name')}",
                "askBeacon": "{get('cache.dependencies.askBeacon')}"
              }
            }
          }
        }
      },
      "args": {
        "offer-policy-id": "{get('args.offer-policy-id')}",
        "offer-asset-name": "{get('args.offer-asset-name')}",
        "ask-policy-id": "{get('args.ask-policy-id')}",
        "ask-asset-name": "{get('args.ask-asset-name')}",
        "price-numerator": "{get('args.price-numerator')}",
        "price-denominator": "{get('args.price-denominator')}",
        "utxo-tx-hash": "{get('args.utxo-tx-hash')}",
        "utxo-tx-index": "{get('args.utxo-tx-index')}",
        "utxo-coin-quantity": "{get('args.utxo-coin-quantity')}",
        "utxo-offer-quantity": "{get('args.utxo-offer-quantity')}",
        "ask-quantity": "{get('args.ask-quantity')}",
        "offer-quantity": "{get('args.offer-quantity')}",
        "offer-address": "{get('cache.myAddress')}",
        "owner-stake-keyhash": "{get('args.owner-stake-keyhash')}",
        "intent-id": "{get('args.intent-id')}"
      }
    },
    "tx": {
      "type": "macro",
      "run": {
        "inputs": [
          "{get('cache.swapOfferIntent.tx.inputs.offerWithBeacons')}"
        ],
        "outputs": [
          "{get('cache.swapOfferIntent.tx.outputs.filledOffer')}",
          "{get('cache.swapOfferIntent.tx.outputs.remainingOfferWithBeacons')}"
        ],
        "witnesses": {
          "plutus": {
            "scripts": [
              "{get('cache.swapOfferIntent.tx.witnesses.plutus.scripts.spendingValidator')}"
            ],
            "consumers": [
              "{get('cache.swapOfferIntent.tx.witnesses.plutus.consumers.offerWithBeaconsSpend')}"
            ]
          }
        },
        "options": {
          "collateralCoinSelection": "LASLAD"
        }
      }
    },
    "build": {
      "type": "buildTx",
      "title": "Swap Limit Order",
      "tx": "{get('cache.tx')}"
    },
    "sign": {
      "type": "signTxs",
      "detailedPermissions": false,
      "txs": [
        "{get('cache.build.txHex')}"
      ]
    },
    "submit": {
      "type": "submitTxs",
      "mode": "noWait",
      "txs": "{get('cache.sign')}"
    },
    "finally": {
      "type": "macro",
      "run": {
        "txHash": "{get('cache.build.txHash')}",
        "index": "{get(  join('.','cache.build.indexMap.output', join('-',get('cache.swapOfferIntent.intentTag'),'remainingOfferWithBeacons') )  )}",
        "pairBeacon": "{get('cache.swapOfferIntent.pairBeacon')}",
        "offerPolicyId": "{get('args.offer-policy-id')}",
        "offerAssetName": "{get('args.offer-asset-name')}",
        "offerBeacon": "{get('cache.swapOfferIntent.offerBeacon')}",
        "askPolicyId": "{get('args.ask-policy-id')}",
        "askAssetName": "{get('args.ask-asset-name')}",
        "askBeacon": "{get('cache.swapOfferIntent.askBeacon')}"
      }
    }
  }
}