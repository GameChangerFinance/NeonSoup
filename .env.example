VITE_NEONSOUP_PREPROD_BLOCKFROST_URL=https://cardano-preprod.blockfrost.io/api/v0
VITE_NEONSOUP_PREPROD_BLOCKFROST_KEY=
VITE_NEONSOUP_MAINNET_BLOCKFROST_URL=https://cardano-mainnet.blockfrost.io/api/v0
VITE_NEONSOUP_MAINNET_BLOCKFROST_KEY=
VITE_NEONSOUP_PREPROD_GRAPHQL_MK2_URL=
VITE_NEONSOUP_MAINNET_GRAPHQL_MK2_URL=
# Enable custom GameChanger wallet URL pattern overrides only in trusted local/dev builds.
VITE_NEONSOUP_ENABLE_WALLET_URL_PATTERN_OVERRIDE=false
# Example for a local wallet dev deployment:
# VITE_NEONSOUP_GC_WALLET_URL_PATTERN=http://localhost:3000/api/2/run/{gcscript}
VITE_NEONSOUP_GC_WALLET_URL_PATTERN=
VITE_NEONSOUP_BUILD_TAG=local
NEONSOUP_GOOGLE_ANALYTICS_ID=

# NeonSoup service fees. Quantities are display units and are converted with the configured asset decimals.
VITE_NEONSOUP_PREPROD_SERVICE_FEE_ADDRESS=
VITE_NEONSOUP_PREPROD_BUNDLE_SWAP_SERVICE_FEE_POLICY_ID=ada
VITE_NEONSOUP_PREPROD_BUNDLE_SWAP_SERVICE_FEE_ASSET_NAME=ada
VITE_NEONSOUP_PREPROD_BUNDLE_SWAP_SERVICE_FEE_QUANTITY=1
VITE_NEONSOUP_PREPROD_PARALLEL_SWAP_SERVICE_FEE_POLICY_ID=ada
VITE_NEONSOUP_PREPROD_PARALLEL_SWAP_SERVICE_FEE_ASSET_NAME=ada
VITE_NEONSOUP_PREPROD_PARALLEL_SWAP_SERVICE_FEE_QUANTITY=2
VITE_NEONSOUP_MAINNET_SERVICE_FEE_ADDRESS=
VITE_NEONSOUP_MAINNET_BUNDLE_SWAP_SERVICE_FEE_POLICY_ID=ada
VITE_NEONSOUP_MAINNET_BUNDLE_SWAP_SERVICE_FEE_ASSET_NAME=ada
VITE_NEONSOUP_MAINNET_BUNDLE_SWAP_SERVICE_FEE_QUANTITY=
VITE_NEONSOUP_MAINNET_PARALLEL_SWAP_SERVICE_FEE_POLICY_ID=ada
VITE_NEONSOUP_MAINNET_PARALLEL_SWAP_SERVICE_FEE_ASSET_NAME=ada
VITE_NEONSOUP_MAINNET_PARALLEL_SWAP_SERVICE_FEE_QUANTITY=
